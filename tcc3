-- ===== PART A: Simulate Deadlock =====
-- Run Session 1:
START TRANSACTION;
UPDATE StudentEnrollments SET enrollment_date = '2024-07-01' WHERE student_id = 1;
-- Pause here: wait or sleep manually to allow Session 2 to run up to its first update
-- Example: SELECT SLEEP(10);
UPDATE StudentEnrollments SET enrollment_date = '2024-07-02' WHERE student_id = 2;
COMMIT;


-- Run Session 2 (concurrently with Session 1):
START TRANSACTION;
UPDATE StudentEnrollments SET enrollment_date = '2024-08-01' WHERE student_id = 2;
-- Pause here: wait or sleep manually to allow Session 1 to run second update
-- Example: SELECT SLEEP(10);
UPDATE StudentEnrollments SET enrollment_date = '2024-08-02' WHERE student_id = 1;
COMMIT;


-- ===== PART B: MVCC Concurrent Reads and Writes =====
-- Session A:
SET TRANSACTION ISOLATION LEVEL REPEATABLE READ;
START TRANSACTION;
SELECT * FROM StudentEnrollments WHERE student_id = 1;
-- Pause here, do NOT commit yet

-- Session B (while Session A open):
UPDATE StudentEnrollments SET enrollment_date = '2024-07-10' WHERE student_id = 1;
COMMIT;

-- Back to Session A:
SELECT * FROM StudentEnrollments WHERE student_id = 1;  -- Still sees old date '2024-06-01'
COMMIT;


-- ===== PART C: Locking vs MVCC Reads =====

-- Scenario 1: With Locking (Session A):
START TRANSACTION;
SELECT * FROM StudentEnrollments WHERE student_id = 1 FOR UPDATE;
-- Hold transaction open here

-- Scenario 1: (Session B):
SELECT * FROM StudentEnrollments WHERE student_id = 1;  
-- This will block until Session A commits or rollbacks

-- Commit Session A to release lock:
COMMIT;

-- Scenario 2: With MVCC Normal SELECT (Session A):
START TRANSACTION;
SELECT * FROM StudentEnrollments WHERE student_id = 1;
-- Reads snapshot, no locks

-- Scenario 2: (Session B):
UPDATE StudentEnrollments SET enrollment_date = '2024-08-15' WHERE student_id = 1;
COMMIT;

-- Back to Session A:
SELECT * FROM StudentEnrollments WHERE student_id = 1;  -- Still old data
COMMIT;
